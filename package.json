{
  "name": "abyx-unified-ai-studio",
  "version": "1.0.0",
  "description": "ABYX Unified AI Studio - Standalone Electron Desktop Application",
  "main": "electron/main.js",
  "bin": {
    "abyx": "bin/abyx.js"
  },
  "scripts": {
    "start": "electron .",
    "gateway": "node bin/abyx.js start",
    "run": "node bin/abyx.js run",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.abyx.studio",
    "productName": "ABYX Unified AI Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "abyx.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "agent",
        "to": "agent"
      },
      {
        "from": "services",
        "to": "services"
      },
      {
        "from": "providers",
        "to": "providers"
      },
      {
        "from": "rag",
        "to": "rag"
      },
      {
        "from": "security",
        "to": "security"
      },
      {
        "from": "extensions",
        "to": "extensions"
      },
      {
        "from": "automations",
        "to": "automations"
      },
      {
        "from": "harness",
        "to": "harness"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "db.js",
        "to": "db.js"
      },
      {
        "from": "db_migrations.js",
        "to": "db_migrations.js"
      },
      {
        "from": "data_paths.js",
        "to": "data_paths.js"
      },
      {
        "from": "abyx.ico",
        "to": "abyx.ico"
      },
      {
        "from": "app/dist",
        "to": "app/dist"
      },
      {
        "from": "app/tools/node-win",
        "to": "app/tools/node-win"
      },
      {
        "from": "app/config",
        "to": "app/config"
      },
      {
        "from": "app/speech-backend",
        "to": "app/speech-backend"
      },
      {
        "from": "Abyx.bat",
        "to": "Abyx.bat"
      },
      {
        "from": "windows.bat",
        "to": "windows.bat"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "abyx.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ABYX Unified AI Studio",
      "installerIcon": "abyx.ico",
      "uninstallerIcon": "abyx.ico",
      "artifactName": "ABYX-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "playwright": "^1.65.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
